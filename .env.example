# Skill ids from the Amazon developer console (amzn1.ask.skill....)
SKILL_JARVIS=
SKILL_CLAUDE=

# LiteLLM (OpenAI-compatible, the lane must support tool calling)
LITELLM_URL=http://localhost:4000
# LITELLM_MODEL=chat

# Home Assistant: long-lived token from the profile, used for the MCP tools and late answers
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
# media_player object id of the Echo that answers if last_called is unknown
HA_FALLBACK_DEVICE=echo
# What the exposed entities cover, shown to the model in the house_state tool
# HOUSE_TOPICS=Strom, Gas, Wasser, Rechnungen, Zaehler, Solaranlage, Geraete und Raeume

# Memory MCP server (streamable HTTP) and its bearer token
MEMORY_URL=http://localhost:8765/mcp
MEMORY_TOKEN=

# SearXNG with JSON output enabled
SEARXNG_URL=http://localhost:8888

# Waste calendar: c-trace OData endpoint of your municipality app, its credentials and your address
CTRACE_URL=
CTRACE_USER=
CTRACE_PASSWORD=
WASTE_TOWN=
WASTE_STREET=
WASTE_HOUSE_NO=

# Claude Code: from `claude setup-token`, valid for one year
CLAUDE_CODE_OAUTH_TOKEN=
# CLAUDE_MODEL=sonnet

# ANSWER_DEADLINE=6
